# Artefacts de run : ce sont des sorties, pas des sources. Les trois
# repertoires sont traites de meme -- `reports/` manquait, et ses
# fichiers nomment l'alias TNS et le schema de l'instance de test.
logs/*
!logs/.gitkeep

work/*
!work/.gitkeep

reports/*
!reports/.gitkeep

*.dmp
*.dump
*.log

# La configuration reelle contient un secret. Seul l'exemple est versionne.
config/config.conf
config/*.conf.bak

# Ansible Vault. `all.yml.example` est versionne (structure lisible sans
# dechiffrer) ; le fichier chiffre ne l'est pas : meme chiffre, il
# constitue une cible et dispense de connaitre la structure.
inventory/group_vars/all.yml
inventory/group_vars/*.yml

# Mot de passe du coffre. Il ne doit JAMAIS entrer dans le depot, et pas
# seulement le fichier chiffre : un coffre dont le secret est versionne
# avec son contenu n'est plus un coffre.
*.vault-pass
vault-pass*
.vault_pass

__pycache__/
*.pyc
.venv/
venv/

.vscode/
.idea/

.DS_Store
Thumbs.db
